# docker compose 使用的变量。复制为 .env 后按需修改。
# cp .env.example .env

# 宿主机上暴露的端口，nginx-proxy-manager 反代到这个端口
PORT=8080

# 必填：JWT 签名密钥，生成方式 openssl rand -hex 32
# 未设置时 docker compose 会直接报错，不会用弱默认值启动
JWT_SECRET=

# 同源部署时保持 *（容器内 nginx 已反代 /api 与 /ws，不存在跨域）
CORS_ORIGIN=*

# HTTPS 由 nginx-proxy-manager 终止，浏览器侧是 https，保持 true
COOKIE_SECURE=true

# 信任的代理层数。保持 1 即可：容器内 nginx 已把 X-Forwarded-For 归一化成
# 单一客户端 IP，外层再套多少级反代都不需要改。调大会让限流可被伪造 XFF 绕过。
TRUST_PROXY_HOPS=1

# 令牌有效期
JWT_ACCESS_EXPIRES=30m
JWT_REFRESH_EXPIRES=7d

# ── 管理后台（前端路由 /admin_zds）────────────────────────────────
# 管理员不是普通注册用户，凭据只来自这里。
# 下面两个密码变量都留空时，/api/admin 整体停用（fail closed）。
ADMIN_USERNAME=admin_zds

# 二选一，ADMIN_PASSWORD_HASH 优先。
#
# 推荐 bcrypt hash，明文口令不进 .env。生成方式（在 room-server 目录下执行）：
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1],10))" '你的密码'
# 重要：docker compose 会对 .env 做变量插值，把 hash 里的每个 $ 写成 $$，
# 否则 $2a$10$ 会被当成变量替换掉，容器里拿到的就是一段残缺的 hash。
# 例：$2a$10$abc... 要写成 $$2a$$10$$abc...
ADMIN_PASSWORD_HASH=

# 或者直接写明文。生产环境要求至少 12 位，否则 room-server 拒绝启动。
ADMIN_PASSWORD=

# 管理会话有效期，默认 2 小时。过期即需重新登录，不做刷新轮转。
ADMIN_SESSION_TTL_MS=7200000
# ── 按图搜索（智谱 GLM）─────────────────────────────────────────────
# 任务页「按图搜索」调用智谱多模态模型识别任务截图，仅登录用户可用。
# 留空则该接口返回 503，其余功能不受影响。
ZHIPU_API_KEY=

# 使用的模型，默认 glm-5.3-flash。
ZHIPU_MODEL=glm-5.3-flash

# 每个登录用户每 24 小时可用的识别次数，默认 10。
# 这一项直接对应大模型额度消耗，计数只在内存里，room-server 重启会重置。
ZHIPU_DAILY_LIMIT=10
