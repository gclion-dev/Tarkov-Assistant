# 运行环境：production 时会强制校验 JWT_SECRET，并默认开启 Secure Cookie
NODE_ENV=development
PORT=3001

# 必填。生产环境不允许留空或沿用默认值，至少 32 位。
# 生成方式：openssl rand -hex 32
JWT_SECRET=

JWT_ACCESS_EXPIRES=30m
JWT_REFRESH_EXPIRES=7d

# 同源部署（由 nginx 反代 /api 与 /ws）时填 * 关闭跨域校验；
# 需要跨域时填写前端站点地址，多个用逗号分隔。
CORS_ORIGIN=http://localhost:8001

# HTTPS 由外层 nginx-proxy-manager 终止时，生产环境应保持 true
# COOKIE_SECURE=true

# 信任的代理层数，用于取真实客户端 IP。生产默认 1，
# 因为容器内 nginx 会把 X-Forwarded-For 覆盖成单一且已归一化的客户端 IP。
# TRUST_PROXY_HOPS=1

DB_PATH=./data/room.db

# 房间参数
# ROOM_MAX_MEMBERS=6
# ROOM_TTL_MS=14400000

# ── 管理后台（前端路由 /admin_zds）────────────────────────────────
# 管理员不是 users 表里的账号，凭据只来自这里。
# 两个密码变量都留空时，/api/admin 整体停用（fail closed）。
ADMIN_USERNAME=admin_zds

# 二选一，ADMIN_PASSWORD_HASH 优先。
#
# 推荐：bcrypt hash，.env 里不出现明文口令。生成方式（在 room-server 目录下执行）：
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1],10))" '你的密码'
# 注意 $ 在部分 shell 与 docker-compose 里需要转义，用单引号包裹最稳妥。
# ADMIN_PASSWORD_HASH='$2a$10$...'
#
# 或者直接写明文。生产环境要求至少 12 位，否则服务拒绝启动。
ADMIN_PASSWORD=

# 管理会话有效期，默认 2 小时。管理会话不做刷新轮转，过期即需重新登录。
# ADMIN_SESSION_TTL_MS=7200000

# ── 注册邀请码 ────────────────────────────────────────────────────
# 注册是否必须填邀请码。邀请码只能在管理后台生成（/admin_zds → 邀请码）。
# 不设置时默认跟随管理后台：后台启用则要求邀请码，后台停用则不要求
# （否则没人能生成码，等于把注册通道焊死）。
# INVITE_CODE_REQUIRED=true

# 后台生成邀请码时的默认有效期，默认 30 天。设为 0 表示默认永不过期。
# 生成时可以逐个覆盖这个默认值。
# INVITE_CODE_TTL_MS=2592000000

# ── 按图识别（智谱 GLM-5.3-Flash）──────────────────────────────────
# 任务页「按图搜索」功能，仅登录用户可用。留空时接口返回 503。
# ZHIPU_API_KEY=
# 使用的模型，默认 glm-5.3-flash。
# ZHIPU_MODEL=glm-5.3-flash
# 每个登录用户每 24 小时可用的识别次数，默认 10。
# 计数只在内存里，服务重启会重置。这项直接对应大模型额度消耗，按需调小。
# ZHIPU_DAILY_LIMIT=10
